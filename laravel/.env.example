# ===== Upadyay API — Hostinger SHARED hosting (Single / Premium / Business) =====
APP_NAME=Upadyay
APP_ENV=production
APP_KEY=                      # generate: see DEPLOY.md (php artisan key:generate --show, or install.php prints one)
APP_DEBUG=false
APP_URL=https://api.upadyay.com   # the API subdomain (Hostinger), no trailing slash
FRONTEND_URL=https://upadyay.com   # the website on Cloudflare Pages (used in password-reset links)
CORS_ORIGINS=https://upadyay.com,https://www.upadyay.com
#CORS_ALLOW_PAGES_DEV=true   # only while testing on *.pages.dev

LOG_CHANNEL=single
LOG_LEVEL=warning

# --- MySQL (hPanel -> Databases -> MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_upadyay
DB_USERNAME=u123456789_upadyay
DB_PASSWORD=

# --- No Redis / no queue worker on shared hosting: keep everything in files or sync ---
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
BROADCAST_CONNECTION=log

# true = employers can publish jobs right after registering. false = admin must approve each company first.
AUTO_APPROVE_COMPANIES=true

# --- Uploads ---
UPLOAD_DISK=uploads           # public images/logos -> <web-root>/api/uploads
UPLOAD_PRIVATE_DISK=local     # resumes/certificates -> storage/app/private (signed links only)
UPLOADS_URL=https://api.upadyay.com/uploads   # public URL of the uploads folder inside the api subdomain folder

# --- Mail: hPanel -> Emails -> create an address, then use its SMTP details ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@upadyay.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@upadyay.com
MAIL_FROM_NAME="Upadyay"

# --- First admin (used by AdminSeeder / install.php; remove the password line afterwards) ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- One-time web installer (deploy/install.php). Set a long random value, then DELETE install.php + this line after use ---
INSTALL_TOKEN=
